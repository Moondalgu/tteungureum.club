# ── Supabase ──────────────────────────────────────────────
# Supabase 프로젝트 Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버 전용(절대 클라이언트 노출 금지). ingest/방생성에서 RLS 우회용
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 카톡 수집기 인증 ──────────────────────────────────────
# reader/config.json 의 secret 과 동일하게 맞출 것
INGEST_SECRET=change-me-to-a-long-random-string

# ── Discord 봇 ────────────────────────────────────────────
# Discord 개발자포털에서 봇 생성 후 토큰, 봇을 초대한 서버(길드) ID
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-guild-id
# (선택) 채널을 특정 카테고리 밑에 생성하려면 카테고리 채널 ID
DISCORD_CATEGORY_ID=

# ── 사이트 주소 ───────────────────────────────────────────
# 디스코드 알림 메시지에 넣을 방 링크 생성에 사용. 배포 도메인으로 설정.
# 예) https://ttdgrm.club  (미설정 시 요청 origin 사용)
NEXT_PUBLIC_SITE_URL=

# ── LiveKit (음성/화면공유) ───────────────────────────────
# LiveKit Cloud(https://cloud.livekit.io) 프로젝트 Settings > Keys 에서 발급
# API_KEY/SECRET 은 서버 전용(토큰 발급에만 사용, 클라이언트 노출 금지)
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
# 프로젝트 접속 URL (wss://로 시작). 클라이언트가 접속에 사용
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
